# Copiá este archivo a .env y completá los valores. .env no se commitea.

NODE_ENV=development
PORT=4000

# Postgres del docker-compose de la raíz (puerto 5433)
DATABASE_URL=postgresql://frente:frente_dev_2026@localhost:5433/frente_noticias

# Firmado de JWT — generá uno propio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Origen permitido para CORS (el frontend Next)
CORS_ORIGIN=http://localhost:3000

# Usuario admin inicial. El seed lo crea SOLO si no existe (nunca pisa una
# cuenta ya creada): tras el primer login cambiá la contraseña desde el panel
# y este valor deja de importar. Usá una larga: openssl rand -base64 24
SEED_ADMIN_EMAIL=admin@fuentedenoticias.com.ar
SEED_ADMIN_PASSWORD=

# --- Ingesta (opcionales) ---
# Los feeds ahora viven en la tabla Feed (CRUD en /admin/feeds).
# RSS_FEEDS solo lo usa prisma/backfill-fase3.ts para la carga inicial.
# RSS_FEEDS=https://ejemplo.com/rss|Política,https://otro.com/rss

# --- Panel de redacción ---
# Horas de vida de un borrador de feed sin publicar antes de purgarlo (cron horario)
# DRAFT_TTL_HOURS=48

# Biblioteca de medios (local | s3)
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=./uploads
MEDIA_PUBLIC_URL=http://localhost:4000/uploads
MEDIA_MAX_MB=8
# Cuota total de subidas por usuario (MB). 0 = sin cuota.
# MEDIA_USER_QUOTA_MB=500
# S3/R2/MinIO (solo con MEDIA_STORAGE=s3)
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
